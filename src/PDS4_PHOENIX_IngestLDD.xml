    <DD_Attribute> 
        <name>instument_mode_id</name>
        <version_id>1.0</version_id>
        <local_identifier>phoenix.instrument_mode_id</local_identifier>
        <nillable_flag>false</nillable_flag>
        <submitter_name>GEO</submitter_name>
        <definition>The instument_mode_id attribute identifies an instrument-dependent designation of operating mode.</definition>
        <DD_Value_Domain>
            <enumeration_flag>true</enumeration_flag>
            <value_data_type>ASCII_Short_String_Collapsed</value_data_type>
            <!-- Keep enumerated values in alphabetical order to avoid duplicates. -->
            <DD_Permissible_Value>
                <value>CME</value>
                <value_meaning>Phoenix MECA Instrument Mode = CME, MECA Control and Measurement Electronics.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>COUPONS_TABLE</value>
                <value_meaning>Phoenix MECA Instrument Mode = COUPONS_TABLE, one of six onboard tables that modify the operation of the MECA flight software.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>COND</value>
                <value_meaning>Phoenix MECA WCL Instrument Mode = COND, a time-series of electrical conductivity measurements.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>CP</value>
                <value_meaning>Phoenix MECA WCL Instrument Mode = CP, a time-series of electrode potential and current chronopotentiometry measurements.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>CV</value>
                <value_meaning>Phoenix MECA WCL Instrument Mode = CV, a time-series of electrode potential and current cyclic voltammetry measurements.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>DOX</value>
                <value_meaning>Phoenix MECA WCL Instrument Mode = DOX, a time-series of dissolved oxygen measurements acquired with an ion selective electrode with CV-style detection.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>ISES</value>
                <value_meaning>Phoenix MECA WCL Instrument Mode = ISES, a time-series of ion selective electrode data.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>FRQTEST</value>
                <value_meaning>Phoenix MECA AFM Instrument Mode = FRQTEST, AFM frequency test.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>N/A</value>
                <value_meaning>Not applicable.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>PARAM_VALUE_TABLE</value>
                <value_meaning>Phoenix MECA Instrument Mode = PARAM_VALUE_TABLE, one of six onboard tables that modify the operation of the MECA flight software.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>PT</value>
                <value_meaning>Phoenix MECA WCL Instrument Mode = PT, a time-series of pressure and temperature measurements.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>PWR</value>
                <value_meaning>Phoenix MECA Instrument Mode = PWR, a time series of voltage and current values provided by the primary MECA 5V (load and logic) and 15V (load 
                    and AFM) power supplies.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>                
                <value>SCAN</value>
                <value_meaning>Phoenix MECA TECP or AFM Instrument Mode = SCAN, indicating scanning mode.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>STATE_TABLE</value>
                <value_meaning>Phoenix MECA Instrument Mode = STATE_TABLE, one of six onboard tables that modify the operation of the MECA flight software.</value_meaning>
            </DD_Permissible_Value>
            <DD_Permissible_Value>
                <value>TIPS_TABLE</value>
                <value_meaning>Phoenix MECA AFM Instrument Mode = TIPS_TABLE, data resulting from initialization and test of the Wheatstone Bridge used to monitor the 
                    deflection of the AFM cantilevers. Or, Phoenix MECA Instrument Mode = TIPS_TABLE, one of six onboard tables that modify the operation of the MECA flight software.</value_meaning>
            </DD_Permissible_Value>
       </DD_Value_Domain>
    </DD_Attribute>
    
